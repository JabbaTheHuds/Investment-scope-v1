# ─── CryptoScope AI environment ──────────────────────────────────────────────
# Copy to .env.local for local development. NEVER commit real secrets.
# All keys below are read server-side only; none are exposed to the browser.

# Data mode:
#   live  – real market data from CoinGecko (default)
#   demo  – clearly-labelled SYNTHETIC data with fictional assets, for UI testing only
DATA_MODE=live

# CoinGecko API plan: "public" (no key, strict rate limits), "demo" (free Demo key), or "pro".
COINGECKO_PLAN=public
# Required when COINGECKO_PLAN is "demo" or "pro". Get one at https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Outbound request budget to CoinGecko (requests per minute). Keep below your plan's limit.
# Public ≈ 5–15/min (varies), Demo = 30/min, Pro = plan-dependent.
COINGECKO_RATE_LIMIT_PER_MIN=20

# Optional: override the CoinGecko base URL (e.g. a caching proxy, or the local stand-in used by E2E tests).
COINGECKO_BASE_URL=

# Inbound API rate limit per client IP (requests per minute) for /api/* routes.
API_RATE_LIMIT_PER_MIN=120

# ─── Later phases (not required for Phase 1) ─────────────────────────────────
# PostgreSQL (Prisma) – used by Phase 4+ (accounts, portfolios, alerts).
DATABASE_URL=postgresql://cryptoscope:cryptoscope@localhost:5432/cryptoscope?schema=public
# Redis – shared cache / job queues once more than one server instance runs.
REDIS_URL=
# AI analyst (Phase 3) – server-side only.
ANTHROPIC_API_KEY=
